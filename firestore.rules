rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Aturan Pengguna & Pengikatan Perangkat (Device Binding)
    match /users/{userId} {
      allow read: if true;
      allow update: if request.auth != null;
      allow create: if request.auth != null;
    }

    // Aturan Presensi Lapangan BNPB
    match /attendances/{attendanceId} {
      // Izinkan baca publik untuk Dashboard Pusdalops BNPB
      allow read: if true;

      // Izinkan pembuatan presensi dengan validasi integritas koordinat dan anti-spoofing
      allow create: if request.resource.data.isMockLocation == false &&
                       request.resource.data.latitude is number &&
                       request.resource.data.longitude is number;

      allow update, delete: if request.auth != null && request.auth.token.role == 'admin';
    }
  }
}
